--- /dev/null
+++ b/backend/templates/nakama-game-backend/nakama/tests/identity_exchange.test.js
@@ -0,0 +1,54 @@
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const vm = require("node:vm");
+const key = "test-only-game-backend-key-at-least-32-bytes";
+function load(envOverrides = {}) {
+  const context = vm.createContext({});
+  vm.runInContext(fs.readFileSync(path.join(__dirname, "../modules/index.js"), "utf8"), context);
+  context.MODULE_CONFIG = context.loadConfig({ env: { GAME_ID: "fixture_game", PLATFORM_IDENTITY_URL: "https://identity.test", TPX_NAKAMA_EXCHANGE_KEY: key, ...envOverrides } });
+  const calls = [];
+  const nk = { httpRequest(url, method, headers, body) { calls.push({ url, headers, body: JSON.parse(body) }); return { code: 200, body: '{"session_token":"test-session"}' }; } };
+  return { context, calls, nk };
+}
+for (const method of ["rpcPlatformAuthExchange", "exchangePlatformSession"]) {
+  const invoke = (context, nk, ctx, payload = "{}") => method === "rpcPlatformAuthExchange" ? context[method](ctx, {}, nk, payload) : context[method](ctx, nk);
+  test(`${method}: requires authenticated context and dedicated server credential before HTTP`, () => {
+    for (const ctx of [undefined, {}, { userId: " " }, { userId: 42 }]) {
+      const { context, calls, nk } = load();
+      assert.throws(() => invoke(context, nk, ctx), /User session is required/);
+      assert.equal(calls.length, 0);
+    }
+    for (const supplied of ["", "short", "invalid-key\n"]) {
+      const { context, calls, nk } = load({ TPX_NAKAMA_EXCHANGE_KEY: supplied, PLATFORM_INTERNAL_KEY: key });
+      assert.throws(() => invoke(context, nk, { userId: "caller" }), /TPX_NAKAMA_EXCHANGE_KEY/);
+      assert.equal(calls.length, 0);
+    }
+  });
+  test(`${method}: ignores client-selected identity/game/key and uses only server context`, () => {
+    const { context, calls, nk } = load();
+    invoke(context, nk, { userId: "caller", username: "Player", nakama_user_id: "victim", game_id: "other" }, JSON.stringify({ nakama_user_id: "victim", game_id: "other", backendKey: "client-key" }));
+    assert.equal(calls.length, 1);
+    assert.equal(calls[0].body.nakama_user_id, "caller");
+    assert.equal(calls[0].body.game_id, "fixture_game");
+    assert.equal(calls[0].headers["x-nakama-exchange-key"], key);
+    assert.equal(calls[0].headers["x-admin-key"], undefined);
+  });
+  test(`${method}: rejects platform authentication failure`, () => {
+    const { context, nk } = load();
+    nk.httpRequest = () => ({ code: 401, body: "{}" });
+    assert.throws(() => invoke(context, nk, { userId: "caller" }), /exchange failed/);
+  });
+}
+test("template runtime selection and token substitution stay game-neutral", () => {
+  for (const file of ["local.yml", "../render.yaml"]) {
+    const raw = fs.readFileSync(path.join(__dirname, "..", file), "utf8");
+    const rendered = raw.replaceAll("__GAME_ID__", "fixture_game").replaceAll("__LEADERBOARD_ID__", "fixture_game_high_scores").replaceAll("__DEFAULT_SERVER_KEY__", "fixture-dev-key");
+    assert.doesNotMatch(rendered, /__[A-Z0-9_]+__/);
+    assert.match(rendered, /TPX_NAKAMA_EXCHANGE_KEY/);
+  }
+  const startup = fs.readFileSync(path.join(__dirname, "../render/start.sh"), "utf8");
+  assert.match(startup, /js_entrypoint: "index\.js"/);
+  assert.match(startup, /TPX_NAKAMA_EXCHANGE_KEY=\$\{NAKAMA_EXCHANGE_KEY_VALUE\}/);
+});
