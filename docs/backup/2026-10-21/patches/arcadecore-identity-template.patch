new file mode 100644
index 0000000..3b0b15e
--- /dev/null
+++ b/backend/tests/legacy_identity_proxy.test.cjs
@@ -0,0 +1,21 @@
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const vm = require("node:vm");
+const crypto = require("node:crypto");
+const { Readable } = require("node:stream");
+test("legacy guest proxy cannot mint a session or forward an exchange credential", async () => {
+  let handler, requests = 0;
+  const source = fs.readFileSync(path.join(__dirname, "../server.js"), "utf8").replace(/^import .*;\n/gm, "");
+  const context = vm.createContext({ http: { createServer(fn) { handler = fn; return { listen() {} }; } }, crypto, process: { env: { TPX_NAKAMA_EXCHANGE_KEY: "test-only-key-must-never-be-forwarded" } }, console, URL, Buffer, fetch() { requests++; throw new Error("unexpected exchange"); } });
+  vm.runInContext(source, context);
+  const req = Readable.from([JSON.stringify({ device_id: "client-selected-device", nakama_user_id: "victim" })]);
+  req.method = "POST"; req.url = "/auth/guest"; req.headers = {};
+  const res = { setHeader() {}, end(body) { this.body = JSON.parse(body); } };
+  await handler(req, res);
+  assert.equal(res.statusCode, 503);
+  assert.match(res.body.error, /Legacy identity proxy disabled/);
+  assert.equal(requests, 0);
+  assert.equal(res.body.session_token, undefined);
+});
