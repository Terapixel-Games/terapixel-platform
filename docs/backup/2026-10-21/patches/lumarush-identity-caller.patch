diff --git a/backend/nakama/render/start.sh b/backend/nakama/render/start.sh
index a81e266..6281fa4 100644
--- a/backend/nakama/render/start.sh
+++ b/backend/nakama/render/start.sh
@@ -75,6 +75,12 @@ RUNTIME_ENV_TPX_API_KEY="${TPX_PLATFORM_API_KEY:-}"
 RUNTIME_ENV_TPX_IAP_VERIFY_URL="${TPX_PLATFORM_IAP_VERIFY_URL:-}"
 RUNTIME_ENV_TPX_IAP_ENTITLEMENTS_URL="${TPX_PLATFORM_IAP_ENTITLEMENTS_URL:-}"
 RUNTIME_ENV_TPX_IAP_COINS_ADJUST_URL="${TPX_PLATFORM_IAP_COINS_ADJUST_URL:-}"
+# The generated runtime YAML uses double-quoted strings. Accept a safe credential
+# alphabet and never print its value in errors. Empty disables exchange only.
+RUNTIME_ENV_TPX_NAKAMA_EXCHANGE_KEY="${TPX_NAKAMA_EXCHANGE_KEY:-}"
+case "$RUNTIME_ENV_TPX_NAKAMA_EXCHANGE_KEY" in
+  *[!A-Za-z0-9_-]*) echo "TPX_NAKAMA_EXCHANGE_KEY has an invalid format"; exit 1 ;;
+esac
 RUNTIME_ENV_TPX_IDENTITY_NAKAMA_AUTH_URL="${TPX_PLATFORM_IDENTITY_NAKAMA_AUTH_URL:-}"
 RUNTIME_ENV_TPX_MERGE_CODE_URL="${TPX_PLATFORM_ACCOUNT_MERGE_CODE_URL:-}"
 RUNTIME_ENV_TPX_MERGE_REDEEM_URL="${TPX_PLATFORM_ACCOUNT_MERGE_REDEEM_URL:-}"
@@ -95,6 +101,10 @@ RUNTIME_ENV_LEADERBOARD_ID="${LUMARUSH_LEADERBOARD_ID:-lumarush_high_scores}"
 NAKAMA_SOCKET_PORT="${NAKAMA_SOCKET_PORT:-7354}"
 NAKAMA_CONSOLE_PORT="${NAKAMA_CONSOLE_PORT:-7355}"
 
