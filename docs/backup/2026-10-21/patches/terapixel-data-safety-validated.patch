diff --git a/test/postgres-iap-atomicity.test.js b/test/postgres-iap-atomicity.test.js
new file mode 100644
index 0000000..c5886cc
--- /dev/null
+++ b/test/postgres-iap-atomicity.test.js
@@ -0,0 +1,106 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { PostgresIapStore } from "../services/iap-service/index.js";
+
+// Scripted client tests validate SQL/control flow, not real PostgreSQL locking.
+function scriptedStore(steps, { connectError } = {}) {
+  const events = [];
+  const releases = [];
+  const client = {
+    async query(sql, params) {
+      const normalized = sql.replace(/\s+/g, " ").trim();
+      events.push(normalized);
+      const step = steps.shift();
+      assert.ok(step, `unexpected SQL: ${normalized}`);
+      assert.match(normalized, step.sql);
+      step.check?.(params, normalized);
+      if (step.error) throw step.error;
+      return { rows: step.rows || [] };
+    },
+    release(error) { releases.push(error); }
+  };
+  const pool = {
+    async query() { throw new Error("pool.query used inside transaction"); },
+    async connect() { if (connectError) throw connectError; return client; }
+  };
+  return { store: new PostgresIapStore({ pool }), events, releases, steps };
+}
+const record = { profileId: "player", type: "consumable", productId: "coins" };
+const effect = { coins: { gameId: "lumarush", delta: 50 } };
+const insert = { sql: /INSERT INTO iap_transactions/, rows: [{ raw: record }] };
+const wallet = { sql: /INSERT INTO iap_coin_balances/ };
+const update = { sql: /UPDATE iap_coin_balances.*balance::bigint \+ \$3::bigint >= 0.*RETURNING balance/, rows: [{ balance: 50 }] };
+const begin = { sql: /^BEGIN$/ };
+const commit = { sql: /^COMMIT$/ };
+const rollback = { sql: /^ROLLBACK$/ };
+
+describe("Postgres IAP pinned-client transactions (mocked)", () => {
+  it("inserts dedupe and grants on one client before commit/release", async () => {
+    const fixture = scriptedStore([begin, insert, wallet, { ...update, check(params) { assert.deepEqual(params, ["player", "lumarush", 50]); } }, commit]);
+    assert.equal((await fixture.store.applyTransaction("google", "tx", record, effect)).isNew, true);
+    assert.deepEqual(fixture.releases, [undefined]);
+    assert.equal(fixture.steps.length, 0);
+  });
+
+  it("deduplicated retry reads existing record on pinned client and skips grant", async () => {
+    const fixture = scriptedStore([begin, { sql: /INSERT INTO iap_transactions/ }, { sql: /SELECT raw FROM iap_transactions/, rows: [{ raw: record }] }, commit]);
+    const result = await fixture.store.applyTransaction("google", "tx", record, effect);
+    assert.equal(result.isNew, false);
+    assert.deepEqual(result.record, record);
+    assert.equal(fixture.steps.length, 0);
+    assert.deepEqual(fixture.releases, [undefined]);
+  });
+
+  it("insufficient debit rolls back its inserted success key and releases", async () => {
+    const fixture = scriptedStore([begin, insert, wallet, { ...update, rows: [] }, rollback]);
+    await assert.rejects(fixture.store.applyTransaction("internal_coin_adjust", "spend", record, { coins: { gameId: "lumarush", delta: -60 } }), /insufficient coins/);
+    assert.equal(fixture.steps.length, 0);
+    assert.deepEqual(fixture.releases, [undefined]);
+  });
+
+  for (const stage of ["dedupe", "wallet", "grant", "commit"]) {
+    it(`rolls back/releases on ${stage} failure`, async () => {
+      const failure = new Error(`${stage} failure`);
+      const sequence = [begin, insert, wallet, update, commit];
+      const index = { dedupe: 1, wallet: 2, grant: 3, commit: 4 }[stage];
+      const steps = sequence.slice(0, index + 1).map((step, i) => i === index ? { ...step, error: failure } : step);
+      const fixture = scriptedStore([...steps, rollback]);
+      await assert.rejects(fixture.store.applyTransaction("google", "tx", record, effect), (error) => error === failure);
+      assert.equal(fixture.steps.length, 0);
+      assert.deepEqual(fixture.releases, [undefined]);
+    });
+  }
+
+  it("preserves original error and discards client if rollback fails", async () => {
+    const failure = new Error("grant failure");
+    const rollbackFailure = new Error("connection lost during rollback");
+    const fixture = scriptedStore([begin, insert, wallet, { ...update, error: failure }, { ...rollback, error: rollbackFailure }]);
+    await assert.rejects(fixture.store.applyTransaction("google", "tx", record, effect), (error) => error === failure);
+    assert.deepEqual(fixture.releases, [rollbackFailure]);
+  });
+
+  it("releases a client when BEGIN fails and handles acquisition failure", async () => {
+    const failure = new Error("begin failure");
+    const fixture = scriptedStore([{ ...begin, error: failure }]);
+    await assert.rejects(fixture.store.applyTransaction("google", "tx", record, effect), (error) => error === failure);
+    assert.deepEqual(fixture.releases, [failure]);
+    const unavailable = scriptedStore([], { connectError: failure });
+    await assert.rejects(unavailable.store.applyTransaction("google", "tx", record, effect), (error) => error === failure);
+    assert.equal(unavailable.releases.length, 0);
+  });
+
+  it("rolls back dedupe when the existing subscription write fails", async () => {
+    const failure = new Error("subscription write failure");
+    const fixture = scriptedStore([begin, insert, { sql: /INSERT INTO iap_subscriptions/, error: failure }, rollback]);
+    await assert.rejects(fixture.store.applyTransaction("apple", "sub", record, { subscription: { active: true } }), (error) => error === failure);
+    assert.equal(fixture.steps.length, 0);
+    assert.deepEqual(fixture.releases, [undefined]);
+  });
+
+  it("keeps the existing subscription write inside the same transaction", async () => {
+    const fixture = scriptedStore([begin, insert, { sql: /INSERT INTO iap_subscriptions/ }, commit]);
+    await fixture.store.applyTransaction("apple", "sub", record, { subscription: { active: true, status: "active" } });
+    assert.equal(fixture.steps.length, 0);
+    assert.deepEqual(fixture.releases, [undefined]);
+  });
+});
diff --git a/test/postgres-iap-integration.test.js b/test/postgres-iap-integration.test.js
new file mode 100644
index 0000000..c2b452f
--- /dev/null
+++ b/test/postgres-iap-integration.test.js
@@ -0,0 +1,66 @@
+import { localPostgresUrl } from "../tools/test-helpers/localPostgresUrl.js";
+import { it } from "node:test";
+import assert from "node:assert/strict";
+import { createIapService, PostgresIapStore } from "../services/iap-service/index.js";
+
+// Opt-in only: never use DATABASE_URL or a remote host. Requires an existing
+// local PostgreSQL server and npm-installed pg. Creates/drops one isolated schema.
+it("real local PostgreSQL: atomic grants, failed-debit retries and concurrent spends", {
+  skip: !process.env.IAP_TEST_LOCAL_DATABASE_URL,
+  timeout: 30_000
+}, async () => {
+  const url = localPostgresUrl(process.env.IAP_TEST_LOCAL_DATABASE_URL);
+  const { default: pg } = await import("pg");
+  const schema = `iap_atomic_test_${process.pid}_${Date.now()}`;
+  const admin = new pg.Pool({ connectionString: url.toString(), max: 1, connectionTimeoutMillis: 3000 });
+  let pool;
+  let created = false;
+  try {
+    await admin.query(`CREATE SCHEMA ${schema}`);
+    created = true;
+    pool = new pg.Pool({ connectionString: url.toString(), options: `-c search_path=${schema}`, max: 8, connectionTimeoutMillis: 3000 });
+    const store = new PostgresIapStore({ pool });
+    await store.init();
+    const service = createIapService({ store, providerRegistry: {
+      async verifyPurchase({ provider, catalogEntry, payload }) {
+        return { provider, externalTransactionId: payload.transaction_id, type: "consumable", gameId: catalogEntry.gameId, coinsDelta: catalogEntry.coins };
+      }
+    } });
+    const buy = (id, profileId = "buyer") => service.verifyPurchase({ profileId, provider: "google", productId: "coins_500_lumarush", exportTarget: "android", payload: { transaction_id: id } });
+    const adjust = (delta, key) => service.adjustCoins({ profileId: "spender", gameId: "lumarush", delta, idempotencyKey: key });
+
+    // Raise after the dedupe INSERT, during the grant, using a real DB trigger.
+    await pool.query(`CREATE FUNCTION reject_grant() RETURNS trigger LANGUAGE plpgsql AS $$
+      BEGIN RAISE EXCEPTION 'injected wallet grant failure'; END $$`);
+    await pool.query(`CREATE TRIGGER reject_grant BEFORE UPDATE ON iap_coin_balances
+      FOR EACH ROW EXECUTE FUNCTION reject_grant()`);
+    await assert.rejects(buy("faulted-purchase", "faulted-buyer"), /injected wallet grant failure/);
+    assert.deepEqual(await store.getCoins("faulted-buyer"), {});
+    assert.equal((await pool.query("SELECT COUNT(*)::int AS n FROM iap_transactions")).rows[0].n, 0);
+    await pool.query("DROP TRIGGER reject_grant ON iap_coin_balances");
+    assert.equal((await buy("faulted-purchase", "faulted-buyer")).deduplicated, false);
+    assert.equal((await buy("faulted-purchase", "faulted-buyer")).deduplicated, true);
+    assert.equal((await store.getCoins("faulted-buyer")).lumarush.balance, 500);
+
+    const purchases = await Promise.all(Array.from({ length: 20 }, () => buy("same-purchase")));
+    assert.equal(purchases.filter((result) => !result.deduplicated).length, 1);
+    assert.equal((await store.getCoins("buyer")).lumarush.balance, 500);
+
+    await assert.rejects(adjust(-10, "initially-unfunded"), /insufficient coins/);
+    await adjust(100, "fund");
+    assert.equal((await adjust(-10, "initially-unfunded")).deduplicated, false);
+    assert.equal((await adjust(-10, "initially-unfunded")).deduplicated, true);
+    const spends = await Promise.allSettled(Array.from({ length: 20 }, (_, i) => adjust(-10, `spend-${i}`)));
+    assert.equal(spends.filter((result) => result.status === "fulfilled").length, 9);
+    assert.equal(spends.filter((result) => result.status === "rejected" && /insufficient coins/.test(result.reason.message)).length, 11);
+    assert.equal((await store.getCoins("spender")).lumarush.balance, 0);
+    const failed = spends.findIndex((result) => result.status === "rejected");
+    await adjust(10, "refill");
+    assert.equal((await adjust(-10, `spend-${failed}`)).deduplicated, false);
+    assert.equal((await store.getCoins("spender")).lumarush.balance, 0);
+  } finally {
+    if (pool) await pool.end();
+    try { if (created) await admin.query(`DROP SCHEMA ${schema} CASCADE`); }
+    finally { await admin.end(); }
+  }
+});
diff --git a/test/postgres-save-concurrency.test.js b/test/postgres-save-concurrency.test.js
new file mode 100644
index 0000000..ed06dea
--- /dev/null
+++ b/test/postgres-save-concurrency.test.js
@@ -0,0 +1,57 @@
+import { it } from "node:test";
+import assert from "node:assert/strict";
+import { PostgresSaveStore, createSaveService, createDefaultSaveEnvelope, SaveConflictError } from "../services/save-service/index.js";
+const env = (profileId, payload = {}, revision = 1) => createDefaultSaveEnvelope({ gameId: "game", profileId, revision, updatedAt: 1_800_000_000, payload });
+it("Postgres CAS protects absent rows and conditional revisions (mock SQL)", async () => {
+  let query;
+  const store = new PostgresSaveStore({ pool: { async query(sql, params) { query = { sql, params }; return { rows: [] }; } } });
+  assert.equal((await store.compareAndSwap(env("primary"), null)).applied, false);
+  assert.match(query.sql, /ON CONFLICT.*DO NOTHING RETURNING envelope/);
+  assert.doesNotMatch(query.sql, /DO UPDATE/);
+  assert.equal((await store.compareAndSwap(env("primary", {}, 3), 2)).applied, false);
+  assert.match(query.sql, /WHERE.*game_id.*profile_id.*envelope->>'revision'.*\$4/s);
+  assert.equal(query.params[3], 2);
+  const snapshot = env("primary", { concurrent: true }, 2);
+  await store.compareAndSwap(env("primary", {}, 3), 2, snapshot);
+  assert.match(query.sql, /AND envelope = \$5::jsonb/);
+  assert.deepEqual(JSON.parse(query.params[4]), snapshot);
+});
+function scripted(steps) {
+  const released = [];
+  return { released, store: new PostgresSaveStore({ pool: {
+    async query() { throw new Error("migration escaped pinned client"); },
+    async connect() { return {
+      async query(sql, params) {
+        const step = steps.shift(); assert.ok(step, sql); assert.match(sql.replace(/\s+/g, " ").trim(), step.sql);
+        step.check?.(params); if (step.error) throw step.error; return { rows: step.rows || [] };
+      }, release(error) { released.push(error); }
+    }; }
+  } }) };
+}
+const begin = { sql: /^BEGIN$/ }, commit = { sql: /^COMMIT$/ }, rollback = { sql: /^ROLLBACK$/ };
+const select = { sql: /^SELECT envelope.*ORDER BY profile_id FOR UPDATE/ };
+const insert = { sql: /^INSERT.*DO NOTHING RETURNING envelope/, rows: [{ envelope: env("primary") }] };
+const update = { sql: /^UPDATE/ }, remove = { sql: /^DELETE/ };
+it("Postgres migration rolls back destination-insert races without deleting source", async () => {
+  const steps = [begin, { ...select, rows: [{ envelope: env("secondary") }] }, { ...insert, rows: [] }, rollback];
+  const { store, released } = scripted(steps);
+  await assert.rejects(store.migrateProfileGame("game", "primary", "secondary", 1_800_000_001), SaveConflictError);
+  assert.equal(steps.length, 0); assert.deepEqual(released, [undefined]);
+});
+it("Postgres migration retries/remerges a raced destination on a fresh transaction", async () => {
+  const steps = [begin, { ...select, rows: [{ envelope: env("secondary", { games_played: 8 }) }] }, { ...insert, rows: [] }, rollback,
+    begin, { ...select, rows: [{ envelope: env("secondary", { games_played: 8 }) }, { envelope: env("primary", { high_score: 90 }) }] },
+    { ...update, check(params) { const result = JSON.parse(params[2]); assert.equal(result.payload.high_score, 90); assert.equal(result.payload.games_played, 8); } }, remove, commit];
+  const { store, released } = scripted(steps);
+  // The service lists games once, but the adapter re-reads both rows per attempt.
+  store.listByProfile = async () => [env("secondary")];
+  assert.deepEqual(await createSaveService({ saveStore: store }).mergeProfiles({ primaryProfileId: "primary", secondaryProfileId: "secondary", nowSeconds: 1_800_000_001 }), { merged: true, affected_games: ["game"] });
+  assert.equal(steps.length, 0); assert.deepEqual(released, [undefined, undefined]);
+});
+it("Postgres source-delete failure rolls back the destination write and releases", async () => {
+  const error = new Error("delete failed");
+  const steps = [begin, { ...select, rows: [{ envelope: env("secondary") }] }, insert, { ...remove, error }, rollback];
+  const { store, released } = scripted(steps);
+  await assert.rejects(store.migrateProfileGame("game", "primary", "secondary", 1_800_000_001), (actual) => actual === error);
+  assert.equal(steps.length, 0); assert.deepEqual(released, [undefined]);
+});
diff --git a/test/postgres-save-integration.test.js b/test/postgres-save-integration.test.js
new file mode 100644
index 0000000..e5fbb20
--- /dev/null
+++ b/test/postgres-save-integration.test.js
@@ -0,0 +1,93 @@
+import { localPostgresUrl } from "../tools/test-helpers/localPostgresUrl.js";
+import { it } from "node:test";
+import assert from "node:assert/strict";
+import { PostgresSaveStore, createSaveService, createDefaultSaveEnvelope } from "../services/save-service/index.js";
+
+it("real local PostgreSQL: concurrent save retries and atomic migration rollback", {
+  skip: !process.env.SAVE_TEST_LOCAL_DATABASE_URL, timeout: 30_000
+}, async () => {
+  // Explicit opt-in only; never fall back to production DATABASE_URL.
+  const url = localPostgresUrl(process.env.SAVE_TEST_LOCAL_DATABASE_URL);
+  const { default: pg } = await import("pg");
+  const schema = `save_test_${process.pid}_${Date.now()}`;
+  const admin = new pg.Pool({ connectionString: url.toString(), max: 1, connectionTimeoutMillis: 3000 });
+  let pool, created = false;
+  try {
+    await admin.query(`CREATE SCHEMA ${schema}`); created = true;
+    pool = new pg.Pool({ connectionString: url.toString(), options: `-c search_path=${schema}`, max: 8, connectionTimeoutMillis: 3000 });
+    const a = new PostgresSaveStore({ pool }), b = new PostgresSaveStore({ pool });
+    await a.init();
+    const envelope = (profile, payload) => ({ ...createDefaultSaveEnvelope({ gameId: "game", profileId: profile, updatedAt: 100 }), payload });
+    // Force both services to read the same snapshot; exercise initial INSERT
+    // conflict and existing-row UPDATE conflict with the real engine.
+    for (const seeded of [false, true]) {
+      const profile = seeded ? "existing" : "initial";
+      if (seeded) await a.put(envelope(profile, {}));
+      let arrivals = 0, release;
+      const gate = new Promise((resolve) => { release = resolve; });
+      const wrap = (store) => ({
+        async get(...args) {
+          const row = await store.get(...args);
+          if (++arrivals <= 2) { if (arrivals === 2) release(); await gate; }
+          return row;
+        }, compareAndSwap: store.compareAndSwap.bind(store)
+      });
+      await Promise.all([
+        createSaveService({ saveStore: wrap(a) }).syncSave({ gameId: "game", profileId: profile, clientEnvelope: envelope(profile, { high_score: 300, left: true }) }),
+        createSaveService({ saveStore: wrap(b) }).syncSave({ gameId: "game", profileId: profile, clientEnvelope: envelope(profile, { games_played: 8, right: true }) })
+      ]);
+      const saved = await a.get("game", profile);
+      assert.equal(saved.payload.high_score, 300); assert.equal(saved.payload.games_played, 8);
+      assert.equal(saved.payload.left, true); assert.equal(saved.payload.right, true);
+      assert.equal(saved.revision, seeded ? 3 : 2);
+    }
+    await a.put(envelope("primary", { high_score: 400 }));
+    await a.put(envelope("secondary", { games_played: 9 }));
+    await pool.query(`CREATE FUNCTION reject_save_delete() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'injected save delete failure'; END $$`);
+    await pool.query("CREATE TRIGGER reject_save_delete BEFORE DELETE ON save_envelopes FOR EACH ROW EXECUTE FUNCTION reject_save_delete()");
+    await assert.rejects(a.migrateProfileGame("game", "primary", "secondary", 200), /injected save delete failure/);
+    assert.equal((await a.get("game", "primary")).revision, 1);
+    assert.equal((await a.get("game", "secondary")).payload.games_played, 9);
+    await pool.query("DROP TRIGGER reject_save_delete ON save_envelopes");
+    await a.migrateProfileGame("game", "primary", "secondary", 200);
+    assert.equal((await a.get("game", "primary")).payload.games_played, 9);
+    assert.equal((await a.get("game", "primary")).payload.high_score, 400);
+    assert.equal(await a.get("game", "secondary"), null);
+
+    // Hold the real source row lock after reading an absent destination, then
+    // let another connection create that destination. INSERT must lose safely,
+    // rollback, and the service must retry/remerge on a fresh transaction.
+    await a.put(envelope("race-secondary", { games_played: 13, secondary_flag: true }));
+    let entered, resume, selections = 0;
+    const selected = new Promise((resolve) => { entered = resolve; });
+    const gate = new Promise((resolve) => { resume = resolve; });
+    const paused = new PostgresSaveStore({ pool: {
+      query: pool.query.bind(pool),
+      async connect() {
+        const client = await pool.connect();
+        return {
+          async query(sql, params) {
+            const result = await client.query(sql, params);
+            if (/ORDER BY profile_id FOR UPDATE/.test(sql) && ++selections === 1) { entered(); await gate; }
+            return result;
+          }, release: client.release.bind(client)
+        };
+      }
+    } });
+    const migration = createSaveService({ saveStore: paused }).mergeProfiles({ primaryProfileId: "race-primary", secondaryProfileId: "race-secondary", nowSeconds: 200 });
+    await selected;
+    try {
+      await createSaveService({ saveStore: b }).syncSave({ gameId: "game", profileId: "race-primary", clientEnvelope: envelope("race-primary", { high_score: 900, primary_flag: true }) });
+    } finally { resume(); }
+    await migration;
+    const raced = await a.get("game", "race-primary");
+    assert.ok(selections >= 2, "destination race must rollback and retry from fresh rows");
+    assert.equal(raced.payload.high_score, 900); assert.equal(raced.payload.games_played, 13);
+    assert.equal(raced.payload.primary_flag, true); assert.equal(raced.payload.secondary_flag, true);
+    assert.equal(await a.get("game", "race-secondary"), null);
+  } finally {
+    if (pool) await pool.end();
+    try { if (created) await admin.query(`DROP SCHEMA ${schema} CASCADE`); }
+    finally { await admin.end(); }
+  }
+});
diff --git a/test/save-concurrency-http.test.js b/test/save-concurrency-http.test.js
