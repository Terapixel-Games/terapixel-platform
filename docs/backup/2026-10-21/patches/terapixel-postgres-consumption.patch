diff --git a/packages/shared-utils/src/postgresTransaction.js b/packages/shared-utils/src/postgresTransaction.js
new file mode 100644
index 0000000..023184d
--- /dev/null
+++ b/packages/shared-utils/src/postgresTransaction.js
@@ -0,0 +1,27 @@
+// A transaction owns one checked-out client, including any helper queries.
+export async function withPostgresTransaction(pool, operation) {
+  const client = await pool.connect();
+  let began = false;
+  let releaseError;
+  try {
+    await client.query("BEGIN");
+    began = true;
+    const result = await operation(client);
+    await client.query("COMMIT");
+    return result;
+  } catch (error) {
+    if (began) {
+      try {
+        await client.query("ROLLBACK");
+      } catch (rollbackError) {
+        releaseError = rollbackError;
+      }
+    } else {
+      releaseError = error;
+    }
+    throw error;
+  } finally {
+    // A failed rollback leaves connection state uncertain; discard that client.
+    client.release(releaseError);
+  }
+}
